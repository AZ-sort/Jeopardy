# Copy this file to .env and fill in ONE key. .env is gitignored and is never
# read by anything but the server process.
#
#   cp .env.example .env
#
# OpenRouter — one key for Gemini, GPT, Llama, DeepSeek, Mistral and the rest.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic — get one at https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Optional. Any id from https://openrouter.ai/models
# OPENROUTER_MODEL=google/gemini-3.8-flash

# Optional. Only needed if BOTH keys above are set: anthropic | openrouter
# AI_PROVIDER=openrouter

# Optional. The port the game runs on.
# PORT=3000

# --- only needed when hosting this publicly ---

# Required for a public deployment: without it anyone with the URL can start a
# game and spend your API credit. Players never need it.
# HOST_PASSWORD=

# --- saved boards (optional) ---
# Boards are saved to an account so they follow you to any device. Both of these
# are needed; without them everything else still works, you just cannot save.
#
# From a Postgres database (Railway provisions DATABASE_URL for you):
# DATABASE_URL=

# From Google Cloud Console, OAuth 2.0 Client ID of type "Web application":
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Any long random string. Without it everyone is signed out on every restart.
# SESSION_SECRET=

# --- AI spend limits (optional, these are the defaults) ---
# GEN_PER_IP_PER_HOUR=20
# GEN_PER_DAY=500
